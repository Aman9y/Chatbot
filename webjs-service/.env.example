# ─────────────────────────────────────────────────────────────────────────────
# webjs-service environment variables
#
# Copy this to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Shared secret between this service and the Python app.
# Must match WEBJS_API_SECRET on the Python side.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBJS_API_SECRET=change-me-to-a-long-random-string

# URL of the Python app's webhook ingestion endpoint.
# On Railway internal networking: http://<python-service>.railway.internal:8000/webhook/whatsapp
# Locally: http://localhost:8000/webhook/whatsapp
PYTHON_WEBHOOK_URL=http://localhost:8000/webhook/whatsapp

# The WhatsApp number attached to this webjs session (E.164 without +).
# Used in the metadata block of forwarded inbound webhooks.
# Example: 919876543210 for +91 9876543210
WEBJS_OWN_NUMBER=91XXXXXXXXXX

# ── Optional / defaults shown ─────────────────────────────────────────────────

# HTTP port this service listens on.
PORT=3001

# Hard cap on unique outbound recipients. CANNOT exceed 250 (enforced in code).
WEBJS_MAX_RECIPIENTS=250

# Path to the JSON file that persists the recipient set across restarts.
# On Railway: mount a Volume at /data and leave this as the default.
WEBJS_RECIPIENT_DB_PATH=/data/recipients.json

# Milliseconds to wait between consecutive outbound sends (queue rate control).
# This is for reliability only — not detection evasion.
WEBJS_SEND_DELAY_MS=1500

# Optional shared secret added as X-Webjs-Secret header on inbound forwards.
# Set this on both sides if you want to verify the source of inbound webhooks.
WEBJS_WEBHOOK_SECRET=

# Directory where whatsapp-web.js stores session credentials.
# Override only if you need a non-default location.
# WEBJS_AUTH_PATH=./.wwebjs_auth
