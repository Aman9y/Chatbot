# ---------------------------------------------------------------------------
# MBBS Abroad Lead Bot — environment configuration (Phase 2)
# Copy to .env and fill in.  Values marked  UNRESOLVED  are the Phase 1 items
# from docs/plan-critique.md that Aman still has to settle; leaving them unset
# is deliberate — the code treats them as explicit "unknown" states, it does
# not invent a value.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- datastores ------------------------------------------------------------
# When you run the app ON THE HOST and Postgres/Redis via docker compose, use the
# published host ports 5433 / 6380 (chosen to dodge any native Postgres/Redis on
# the default ports). When the app itself runs in compose it uses db:5432 /
# redis:6379 (see docker-compose.yml).
# A plain postgres:// or postgresql:// URL from a PaaS (Railway/Render/Heroku) is
# fine too — config.py rewrites it to the +asyncpg driver and fixes ssl params.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot
REDIS_URL=redis://localhost:6380/0

# --- Meta WhatsApp Cloud API --------------------------------------------------
# For local development you can use the Meta test number (free, up to 5 test
# recipients).  WHATSAPP_CLIENT=fake keeps everything offline (default).
WHATSAPP_CLIENT=fake
META_APP_SECRET=dev-app-secret-change-me
META_VERIFY_TOKEN=dev-verify-token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
REQUEST_TIMEOUT_SECONDS=15

# --- conversation windows / cadence ---------------------------------------
SERVICE_WINDOW_HOURS=24
ENGAGEMENT_PUSH_HOURS=24
ENGAGEMENT_HANDOFF_HOURS=48
SILENT_RETRY_MAX_ROUNDS=3

# --- outreach gating -----------------------------------------------------------
# UNRESOLVED (critique A1): until the consent of the ~1,200 legacy leads has been
# audited, no imported lead is "verified" and this gate blocks all bot-initiated
# outreach to them.  Set to false only once the audit is done and documented.
OUTREACH_REQUIRE_VERIFIED_CONSENT=true

# --- minor policy ------------------------------------------------------------
# UNRESOLVED (critique A2): the DPDP / under-18 policy is not decided.  Leads
# detected as minors get this status and are blocked from outreach until it is
# changed to cleared_parent_consent (per lead) or the policy is set.
# One of: pending_review | blocked | cleared_parent_consent | not_applicable
MINOR_DEFAULT_POLICY=pending_review

# --- NEET eligibility ------------------------------------------------------
# Confirmed 2026-09-08 (Hamza): the ~1,200 leads sat the 2026 cycle.
# Leave a value BLANK to force "unknown" (the code no longer guesses).
NEET_YEAR=2026
NEET_CUTOFF_GENERAL=213
NEET_CUTOFF_OBC=175

# --- per-country stateable cost ranges (Stellar, confirmed 2026-09-09) ---
# JSON {"Country": "display range"}. Each range is bound to its country; the
# guard never quotes one country's range for another. Blank/invalid -> the bot
# can state no figures at all.
COUNTRY_COST_RANGES={"Uzbekistan": "₹30–35 lakh", "Kyrgyzstan": "₹30–35 lakh", "Kazakhstan": "₹30–35 lakh", "Russia": "₹27–45 lakh", "Bangladesh": "₹32–45 lakh", "Georgia": "₹38–55 lakh", "Nepal": "₹57–80 lakh"}
# Georgia + Nepal: figure only WITH the reason it's higher AND Rafique Sir's number.
SENSITIVE_COST_COUNTRIES=Georgia,Nepal
# India-private MBBS range — stateable ONLY as the India-vs-abroad comparison.
INDIA_COMPARE_COST_RANGE=₹80L–1.2Cr

# --- opt-out keywords ----------------------------------------------------------
# Comma-separated. The sentinel <defaults> expands to the built-in multi-language
# list (see app/services/stop_keywords.py). Append with: <defaults>,extra1,extra2
STOP_KEYWORDS=<defaults>

# --- phone parsing --------------------------------------------------------
DEFAULT_PHONE_REGION=IN

# --- per-message cost rate card (optional) -------------------------------------
# JSON object mapping "category:country_iso2" -> amount, plus "_currency".
# Meta webhooks report category/billable but not a price; this fills cost_amount
# when you supply your rate card. Default {} -> cost_amount stays null.
# Example: {"_currency":"INR","marketing:IN":0.8709,"utility:IN":0.1250}
WHATSAPP_RATE_CARD={}

# ===========================================================================
# Phase 3 / 4 — conversation engine + Response Guard
# ===========================================================================

# fake (default, offline/deterministic) | anthropic | openai | gemini | openrouter
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
# Gemini (Google AI Studio). Required when LLM_PROVIDER=gemini. Paste your key
# after the `=` in your local .env only — never commit a real key here.
# Free-tier key is fine for testing with SYNTHETIC leads; swap to a paid key
# through this same variable for production (no code change).
GEMINI_API_KEY=
# "-latest" tracks Google's current flash model. Older ids like gemini-2.5-flash
# 404 for new API keys. On a FREE-TIER key the flagship / "-latest" models often
# return 503/504 ("high demand"); pin a specific mid model for testing, e.g.
# GEMINI_MODEL=gemini-3.5-flash  /  GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# A paid key does not hit those limits — leave the "-latest" aliases for prod.
GEMINI_MODEL=gemini-flash-latest
GEMINI_CLASSIFIER_MODEL=gemini-flash-lite-latest
# OpenRouter (OpenAI-compatible gateway). Required when LLM_PROVIDER=openrouter.
# DATA HANDLING: with this provider, every lead message + the system prompt
# (which contains the lead's extracted profile) + recent history is sent to
# OpenRouter's servers, which forward it to the upstream host (Google for the
# gemini route). That is a NEW third-party processor. Read
# docs/llm-data-handling.md, confirm OpenRouter's retention/logging policy for
# API traffic, then set OPENROUTER_DATA_POLICY_CONFIRMED=true. check-config
# flags the provider as unresolved until you do.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_CLASSIFIER_MODEL=google/gemini-3.7-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on the OpenRouter dashboard:
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=
# Routing safety pin — attached to every request so lead data can only reach a
# vetted upstream. Default: Google Vertex only (does not train on API data;
# Google AI Studio's terms can), refuse data-storing endpoints, request
# zero-data-retention, and error instead of falling back elsewhere. Set
# OPENROUTER_PROVIDER_ONLY empty to drop the allow-list.
OPENROUTER_PROVIDER_ONLY=google-vertex
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_REQUIRE_ZDR=true
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_DATA_POLICY_CONFIRMED=false
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1600
LLM_TIMEOUT_SECONDS=40

# Auto-send the bot's reply when: window open + outreach guard passes +
# not human-owned + guard approves the text. Set false to mute the bot entirely.
BOT_AUTOREPLY_ENABLED=true
CONVERSATION_HISTORY_TURNS=12
KB_PATH=app/knowledge/kb.yaml
KB_RETRIEVAL_K=4

# --- consent + age gate (build-plan §2 / DPDP) --------------------------------
# The bot asks a plain opt-in question first, then an age check, and only runs
# the sales/qualification flow once a lead says yes AND confirms 18+. An unclear
# answer is re-asked once then parked for a human; a confirmed minor is held
# pending guidance and flagged to the counsellor.
CONSENT_GATE_ENABLED=true
# The OUTBOUND opt-in drip sweep. Keep OFF until the gate_consent template is
# Meta-approved and you've decided to start contacting the ~1,200 leads.
CONSENT_ASK_SWEEP_ENABLED=false
CONSENT_ASK_TEMPLATE_NAME=gate_consent_v1
CONSENT_ASK_TEMPLATE_LANGUAGE=en
CONSENT_ASK_TEMPLATE_CATEGORY=marketing
CONSENT_ASKS_PER_SWEEP=25
CONSENT_ASK_MAX_ROUNDS=2
CONSENT_ASK_GAP_HOURS=24

# --- turn dispatch / concurrency (build-plan §3) -------------------------------
# celery  : webhook acks Meta immediately, then a Celery task processes the turn
#           with a debounce window + per-lead Redis lock. PRODUCTION setting —
#           needs the worker running (docker compose `worker`).
# inline  : webhook runs the engine in-request, one message at a time (dev/tests).
WEBHOOK_CONVERSATION_DISPATCH=celery
# Wait this long after the ack before processing so a lead's rapid-fire messages
# merge into one turn.
TURN_DEBOUNCE_MS=500
# Per-lead lock: safety TTL, and how long a queued turn waits for it.
TURN_LOCK_TTL_SECONDS=120
TURN_LOCK_MAX_RETRIES=15
TURN_LOCK_RETRY_SECONDS=3

# Response Guard (plan §2 hard rules enforced in code)
GUARD_ENABLED=true
GUARD_LLM_CRITIC_ENABLED=false
GUARD_MAX_REPLY_CHARS=700
GUARD_MAX_REPLY_WORDS=90
GUARD_REGENERATE_ATTEMPTS=1

# Booking detection -> HANDOFF + counsellor notification
BOOKING_DETECTION_ENABLED=true
# Optional: POST handoff notifications here (else they are logged + queued in DB)
COUNSELOR_WEBHOOK_URL=

# ===========================================================================
# Phase 5 / 6 — Celery scheduler (windows, nudges, re-engagement rounds)
# ===========================================================================
# Broker/backend blank -> derived from REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SCHEDULER_ENABLED=true
SWEEP_INTERVAL_SECONDS=300
SCHEDULER_BATCH_SIZE=200

# in-window nudge (0-24h push phase): send when the lead has been quiet this long
NUDGE_AFTER_HOURS=6
NUDGE_MAX_PER_WINDOW=1

# SILENT re-open rounds — per-round delay in hours, index by round.
# Number of entries also caps the rounds (with SILENT_RETRY_MAX_ROUNDS).
REENGAGEMENT_SPACING_HOURS=20,48,72
# These templates must exist + be Meta-approved before real sends work
# (plan §7 — actual template copy still pending).
REENGAGE_TEMPLATE_NAME=reengage_v1
REENGAGE_TEMPLATE_LANGUAGE=en
REENGAGE_TEMPLATE_CATEGORY=marketing

# NURTURE cadence (48h+ no booking)
NURTURE_GAP_DAYS=4
NURTURE_MAX_ROUNDS=2
NURTURE_TEMPLATE_NAME=nurture_v1
NURTURE_TEMPLATE_LANGUAGE=en
NURTURE_TEMPLATE_CATEGORY=marketing

# --- system-prompt values (docs/system-prompt.md CONFIG table) ---------------
# Stellar Educonsultancy — confirmed 2026-09-09. MAPS_LINK / BOOKING_LINK not supplied.
COMPANY_NAME=Stellar Educonsultancy
COUNSELOR_NAME=Rafique Shaikh
# Director's number. Bot shares it in Georgia/Nepal cost replies and on request.
COUNSELOR_PHONE=+91 74478 67887
OFFICE_ADDRESS=A Wing 302, 2nd Floor, Shanti Shopping Center, near Mira Road Railway Station, Mira Road East, Thane 401107
MAPS_LINK=
BOOKING_LINK=
BOT_LANGUAGES=English, Hindi, Hinglish
PREMIUM_COST_COUNTRIES=Germany,United Kingdom,UK,United States,US,USA,Canada,Australia
